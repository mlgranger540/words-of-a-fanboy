{
    "hosting": {
        "public": "public",
        "cleanUrls": true,
        "rewrites": [
            {
                "source": "/page-**",
                "destination": "/recent.html"
            },
            {
                "source": "/all-posts/**",
                "destination": "/all-posts.html"
            },
            {
                "source": "/post/**",
                "destination": "/post.html"
            },
            {
                "source": "/fandom/**",
                "destination": "/posts-by-fandom.html"
            },
            {
                "source": "/media-type/**",
                "destination": "/posts-by-fandom-type.html"
            },
            {
                "source": "/post-type/**",
                "destination": "/posts-by-post-type.html"
            },
            {
                "source": "/getPost/**",
                "function": "woaf_app"
            },
            {
                "source": "/getRecentPosts",
                "function": "woaf_app"
            },
            {
                "source": "/getRecentPosts/**",
                "function": "woaf_app"
            },
            {
                "source": "/getAllPosts",
                "function": "woaf_app"
            },
            {
                "source": "/getPostsByFandom/**",
                "function": "woaf_app"
            },
            {
                "source": "/getPostsByFandomType/**",
                "function": "woaf_app"
            },
            {
                "source": "/getPostsByType/**",
                "function": "woaf_app"
            },
            {
                "source": "**",
                "function": "woaf_app"
            }
        ],
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ]
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log"
            ]
        }
    ]
}
